# Temporary and binary files
*~
*.py[cod]
*.so
*.cfg
!.isort.cfg
!setup.cfg
*.orig
*.log
*.pot
__pycache__/*
.cache/*
.*.swp
*.ipynb_checkpoints*

# Project files
.vscode
.ropeproject
.project
.pydevproject
.settings
.idea
tags

# Package files
*.egg
*.eggs/
.installed.cfg
*.egg-info

# Unittest and coverage
htmlcov/*
.coverage
.tox
junit.xml
coverage.xml
.pytest_cache/

# Build and docs folder/files
build/*
dist/*
sdist/*
docs/api/*
docs/_rst/*
docs/_build/*
cover/*
MANIFEST

# Per-project virtualenvs
.venv*/

# SSH key dir mounted into Docker
/ssh_keys/

# PYNQ board files
/board_files/

# datasets for testing
/dataset/
/data/
*.csv

# Google Drive key for dashboard
/gdrive-key/

# generated files as part of end2end notebooks
/notebooks/end2end_example/**/*.onnx

# downloaded dep repos
/deps/

# No subir los backups de la imagen Docker (pesan ~9GB)
*.tar

# Archivos de salida de hardware (Bitstreams y configuración)
# Estos archivos pueden pesar 50-100MB cada uno y llenan el repo rápido
*.bit
*.hwh
*.xclbin
*.xsa
*.bin

# Carpetas de salida de compilación de FINN
# Normalmente FINN genera carpetas llamadas 'output_*' o 'vivado_output'
/output*/
/vivado_output/
/ip_cache/

# Archivos comprimidos de respaldo
*.zip
*.gz
# Papelera de reciclaje del sistema
.Trash-1000/

# Resultados de compilación de FINN (MUY PESADOS)
output_*/
vivado_output/
intermediate_models/
report/
stitched_ip/
*.onnx
*.pth
*.npz

# Archivos de proyecto de Vivado
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.xpr
vivado.jou
vivado.log

# Otros temporales
*.ipynb_checkpoints/
__pycache__/
# Ignorar CUALQUIER carpeta de salida en cualquier subdirectorio
**/output_*/
**/intermediate_models/
**/report/
**/stitched_ip/

# Ignorar modelos binarios (opcional, pero recomendado si pesan >10MB)
**/*.onnx
**/*.pth
**/*.npz

# Archivos de bitstream y hardware
**/*.bit
**/*.hwh
**/*.xclbin
